{
  "name": "xkaliber-agent",
  "version": "41.9.0",
  "description": "Xkaliber Agent v41.9 - Full-project local coding agent with durable plan memory and a plugin system.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test \"tests/*.test.js\""
  },
  "author": {
    "name": "System76",
    "email": "support@system76.com"
  },
  "homepage": "https://github.com/system76/xkaliber-agent",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "playwright-core": "^1.48.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "diff-match-patch": "^1.0.5",
    "fast-glob": "^3.3.2",
    "highlight.js": "^11.9.0",
    "ignore": "^5.3.1",
    "marked": "^11.1.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6"
  },
  "build": {
    "appId": "com.xkaliber.agent",
    "productName": "Xkaliber Agent",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "xkaliber-agent"
    },
    "extraResources": [
      {
        "from": "resources/piper",
        "to": "piper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
